---
import Logo from "./Logo.astro";
import { data } from "@/data/etfs";
import { czDate } from "@/lib/format";
---

<header class="wrap top">
  <a href="/" aria-label="ETF tahák"><Logo /></a>
  <span class="asof"><span class="live-dot"></span>živá data · {czDate(data.asOf)}</span>
</header>

<style>
  .top { display: flex; align-items: center; justify-content: space-between; padding-top: 16px; padding-bottom: 4px; }
  .top a { text-decoration: none; }
  .asof { display: inline-flex; align-items: center; gap: 8px; font: 500 11px/1 var(--f-mono); color: var(--muted); text-transform: uppercase; }
</style>
