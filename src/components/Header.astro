---
import Logo from "./Logo.astro";
import { data } from "@/data/etfs";
import { czDate } from "@/lib/format";
---

<header class="mx-auto flex max-w-col items-center justify-between px-4 pt-4 pb-1">
  <a href="/" aria-label="ETF tahák" class="no-underline"><Logo /></a>
  <span class="inline-flex items-center gap-2 font-mono text-[11px] leading-none font-medium text-muted uppercase">
    <span class="live-dot"></span>živá data · {czDate(data.asOf)}
  </span>
</header>
