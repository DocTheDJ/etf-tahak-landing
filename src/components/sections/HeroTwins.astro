---
// First screen for ad B ("Broker vám nedovolil koupit VOO?"): the same three pairs as in the ad,
// shown like an order book (blocked on the left, buyable on the right), a teaser row, and the email form.
import LeadForm from "@/components/LeadForm.vue";
import Btn from "@/components/ui/Btn.vue";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Heading from "@/components/ui/Heading.astro";
import Lede from "@/components/ui/Lede.astro";
import { byTicker, etfs, FREE_TWINS } from "@/data/etfs";
import { pct } from "@/lib/format";

const pairs = FREE_TWINS.map(byTicker);
const teaser = byTicker("SCHD");
const remaining = etfs.length - pairs.length - 1;
const note = (e: ReturnType<typeof byTicker>) =>
  e.twin.ter < e.er ? null : e.twin.match === "same" ? "stejný index" : e.focus.toLowerCase();

const row = "grid animate-slide-in grid-cols-2 items-center border-b border-line px-3.5 py-3 last:border-b-0";
const side = "flex flex-col gap-0.5 font-mono";
const small = "text-[11px] text-muted";
---

<Section track="hero_twins" first>
  <Eyebrow tone="coral">Broker řekl „ne“?</Eyebrow>
  <Heading level={1}>VOO z Česka nekoupíte. <span class="text-lime">Jeho dvojče ano.</span></Heading>
  <Lede>Americkým ETF chybí evropský dokument KID, a tak je broker drobnému investorovi v EU neprodá. Každé má ale irské dvojče na stejný index.</Lede>

  <div class="mt-1 mb-5 overflow-hidden rounded-card border border-line bg-surface" aria-label="Ukázka z taháku" data-testid="pairs">
    <div class="grid grid-cols-2 border-b border-line px-3.5 py-2.5 font-mono text-[11px] leading-none font-medium text-muted">
      <span>USA · NYSE</span><span class="text-right">EU · XETRA</span>
    </div>
    {pairs.map((e, i) => (
      <div class={row} style={`animation-delay: ${i * 0.12}s`}>
        <span class={side}><b class="text-[18px] text-coral line-through">{e.ticker}</b><small class={small}>{pct(e.er)} · nekoupíte</small></span>
        <span class:list={[side, "items-end text-right"]}>
          <b class="text-[18px] text-lime">{e.twin.ticker} ✓</b>
          {note(e)
            ? <small class={small}>{pct(e.twin.ter)} · {note(e)}</small>
            : <small class="animate-glow rounded-[5px] bg-lime px-[7px] py-0.5 text-[11px] font-bold text-ink">{pct(e.twin.ter)} · levnější</small>}
        </span>
      </div>
    ))}
    <div class={row} style={`animation-delay: ${pairs.length * 0.12}s`} aria-hidden="true">
      <span class={side}><b class="text-[18px] text-coral line-through">{teaser.ticker}</b><small class={small}>{pct(teaser.er)} · nekoupíte</small></span>
      <span class:list={[side, "items-end text-right"]}>
        <span class="rounded-full bg-fg px-2.5 py-[7px] font-sans text-[12px] leading-none font-bold text-ink">+ {remaining} dalších v taháku</span>
      </span>
    </div>
  </div>

  <!-- A/B test "ask" (Layout sets data-ask before paint): early = form here, late = button to the proof -->
  <div class="ask-late:hidden">
    <LeadForm client:load loc="hero_twins" label={`Pošleme vám všech ${etfs.length} párů s ISINy`} button="Chci je →" />
  </div>
  <div class="ask-early:hidden">
    <Btn href="#srovnani" variant="primary" block data-cta="hero_twins_late">Ukázat všech {etfs.length} párů ↓</Btn>
  </div>
</Section>
