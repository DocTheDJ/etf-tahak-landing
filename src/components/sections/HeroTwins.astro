---
// First screen for ad B ("Broker vám nedovolil koupit VOO?"): the same three pairs as in the ad,
// a blurred fourth as a teaser, and the email form.
import LeadForm from "@/components/LeadForm.vue";
import { byTicker, etfs, FREE_TWINS } from "@/data/etfs";
import { pct } from "@/lib/format";

const pairs = FREE_TWINS.map(byTicker);
const teaser = byTicker("SCHD");
const remaining = etfs.length - pairs.length;
---

<section class="sec sec--first" data-sec="hero_twins">
  <p class="eyebrow">Pro každého, komu broker řekl „ne“</p>
  <h1 class="h1">VOO z Česka nekoupíte. <mark>Jeho dvojče ano.</mark></h1>
  <p class="lede">
    Americké ETF z burzy NYSE nemají evropský dokument KID, a tak je broker drobnému investorovi v EU neprodá. Každé z nich má
    ale evropské dvojče na stejný index. Některá jsou dokonce levnější.
  </p>

  <div class="slip pairs" aria-label="Ukázka z taháku">
    {pairs.map((e) => (
      <div class="pair">
        <span class="us"><b>{e.ticker}</b><i>{pct(e.er)}</i></span>
        <span class="arrow" aria-hidden="true">→</span>
        <span class="eu"><b>{e.twin.ticker}</b><i>{pct(e.twin.ter)}</i></span>
        {e.twin.ter < e.er && <span class="hand note">levnější než originál!</span>}
      </div>
    ))}
    <div class="pair" aria-hidden="true">
      <span class="us"><b>{teaser.ticker}</b><i>{pct(teaser.er)}</i></span>
      <span class="arrow">→</span>
      <span class="eu blur"><b>XXXX</b><i>0,00 %</i></span>
    </div>
    <p class="more">+ {remaining - 1} dalších párů s ISINy v taháku</p>
  </div>

  <!-- A/B test "ask" (Layout sets data-ask before paint): early = form here, late = button to the proof -->
  <div class="ask-early">
    <LeadForm client:load loc="hero_twins" label={`Pošleme vám všech ${etfs.length} párů. Kam?`} />
  </div>
  <div class="ask-late">
    <a class="btn btn--primary btn--block" href="#srovnani" data-cta="hero_twins_late">Ukázat všech {etfs.length} párů ↓</a>
  </div>
</section>

<style>
  .pairs { transform: rotate(-0.6deg); margin: 6px 0 22px; padding: 18px 14px 12px; }
  .pair {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px;
    padding: 9px 0; border-bottom: 1px dashed rgba(22, 20, 15, 0.22); position: relative;
  }
  .us, .eu { display: flex; align-items: baseline; gap: 8px; font-family: var(--f-mono); }
  .us b { font-size: 20px; text-decoration: line-through; text-decoration-color: var(--red); text-decoration-thickness: 2.5px; color: var(--ink-2); }
  .eu b { font-size: 20px; color: var(--green); background: linear-gradient(transparent 55%, var(--marker) 55%); padding: 0 2px; }
  i { font-style: normal; font-size: 13px; color: var(--ink-3); }
  .arrow { font-size: 20px; }
  .note { position: absolute; right: -2px; top: -12px; transform: rotate(-4deg); }
  .more { margin: 6px 0 0; font: 500 13px/1.3 var(--f-mono); color: var(--ink-2); }
  :global([data-ask="early"]) .ask-late, :global([data-ask="late"]) .ask-early { display: none; }
</style>
