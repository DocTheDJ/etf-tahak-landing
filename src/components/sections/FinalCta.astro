---
// The last ask, for visitors who read to the end. The sticky bar and the locked twins scroll here.
import LeadForm from "@/components/LeadForm.vue";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Heading from "@/components/ui/Heading.astro";
---

<Section id="tahak" track="final" last>
  <Eyebrow>Tahák · PDF · 2 strany</Eyebrow>
  <Heading>Přečtete ho za jednu cestu <span class="text-lime">tramvají.</span></Heading>
  <!-- after sign-up the form becomes the thank-you panel, which has its own frame -->
  <div class="rounded-card border border-line bg-surface p-4 has-[[data-testid=thank-you]]:border-0 has-[[data-testid=thank-you]]:bg-transparent has-[[data-testid=thank-you]]:p-0">
    <LeadForm client:visible loc="final" label="Kam vám ho poslat?" />
  </div>
</Section>
