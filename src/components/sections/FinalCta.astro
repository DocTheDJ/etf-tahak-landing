---
// The last ask, for visitors who read to the end. The sticky bar and the locked twins scroll here.
import LeadForm from "@/components/LeadForm.vue";
---

<section class="sec final" id="tahak" data-sec="final">
  <p class="eyebrow">Tahák · PDF · 2 strany</p>
  <h2 class="h2">Přečtete ho za jednu cestu <span class="t-lime">tramvají.</span></h2>
  <div class="box">
    <LeadForm client:visible loc="final" label="Kam vám ho poslat?" />
  </div>
</section>

<style>
.final { padding-bottom: 36px; }
  .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 16px; }
  /* after sign-up the form becomes the thank-you panel, which has its own frame */
  .box:has(.done) { background: none; border: 0; padding: 0; }
</style>
