---
// "Co je v taháku": makes the lead magnet concrete before the next ask.
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import { byTicker, etfs } from "@/data/etfs";

const preview = ["VOO", "IVV", "SPY", "VT", "SCHD"].map(byTicker);
const points = [
  { title: `${etfs.length} ETF z NYSE vedle sebe.`, text: "Poplatek, výnos za 1, 5 a 10 let, dividenda." },
  { title: "Evropské dvojče ke každému.", text: "Ticker, ISIN a poplatek. Stačí zkopírovat do aplikace brokera." },
  { title: "Daně na jedné straně.", text: "Časový test 3 roky, limit 100 000 Kč, formulář W-8BEN a DIP." },
  { title: "5 kroků k prvnímu nákupu.", text: "Od výběru indexu po trvalý příkaz." },
];
---

<Section track="inside">
  <Heading>Co je v taháku</Heading>
  <div class="grid grid-cols-[112px_1fr] items-start gap-5 md:grid-cols-[150px_1fr] md:gap-7">
    <!-- a mini PDF page, floating -->
    <div
      class="relative aspect-[1/1.414] animate-float rounded-[6px] bg-white px-2 py-[9px] font-mono text-[9.5px] leading-[1.4] font-medium text-ink shadow-[0_0_0_1px_var(--color-line),0_18px_40px_rgba(0,0,0,0.5)] [transform:rotate(-4deg)]"
      aria-hidden="true"
    >
      <div class="mb-1.5 border-b border-ink pb-1 font-sans text-[11px] leading-[1.1] font-extrabold"><b>ETF tahák</b> 2026</div>
      {preview.map((e) => (
        <div class="grid grid-cols-[1fr_auto_1fr] gap-[3px]"><span>{e.ticker}</span><span>→</span><span class="bg-lime px-0.5 font-bold">{e.twin.ticker}</span></div>
      ))}
      <div class="mt-2 grid gap-1">
        <i class="block h-[3px] bg-[#e3e5ea]"></i><i class="block h-[3px] w-4/5 bg-[#e3e5ea]"></i><i class="block h-[3px] bg-[#e3e5ea]"></i><i class="block h-[3px] w-3/5 bg-[#e3e5ea]"></i>
      </div>
      <span class="absolute -right-3.5 -bottom-3 rounded-[6px] bg-lime px-[7px] py-[5px] font-mono text-[10px] leading-none font-bold whitespace-nowrap text-ink [transform:rotate(6deg)]">PDF · 2 strany</span>
    </div>
    <ol class="grid gap-3.5">
      {points.map((p, i) => (
        <li class="relative pl-8 text-[15.5px] leading-[1.45] text-fg-2">
          <span class="absolute top-0.5 left-0 font-mono text-[12px] leading-none font-bold text-lime" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <b class="text-fg">{p.title}</b> {p.text}
        </li>
      ))}
    </ol>
  </div>
</Section>
