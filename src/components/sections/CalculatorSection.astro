---
// The calculator as a supporting section (twins page). On the fees page the calculator is the hero instead.
import Calculator from "@/components/Calculator.vue";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Heading from "@/components/ui/Heading.astro";
import Lede from "@/components/ui/Lede.astro";
import { CALC_ETF } from "@/data/etfs";
---

<Section id="kalkulacka" track="calculator">
  <Eyebrow>Kalkulačka</Eyebrow>
  <Heading>Proč na procentech záleží</Heading>
  <Lede>Poplatek se strhává z celé částky každý rok. Za 20 let z toho jsou statisíce.</Lede>
  <Calculator client:visible etfTicker={CALC_ETF.ticker} etfFee={CALC_ETF.ter} />
</Section>
