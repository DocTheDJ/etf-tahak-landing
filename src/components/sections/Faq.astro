---
// The four reasons people hesitate at the form, answered right before the final ask.
// Native <details>, so it works without JavaScript; opening one is tracked by the script below.
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";

const items = [
  {
    q: "Proč nemůžu koupit VOO přímo?",
    a: "Od roku 2018 platí v EU nařízení PRIIPs. Fond nabízený drobným investorům musí mít dokument KID s klíčovými informacemi. Americké fondy ho nevydávají, a tak je evropští brokeři pro běžné klienty blokují. Výjimkou jsou „profesionální klienti“, tím ale běžný investor není.",
  },
  {
    q: "Není evropské dvojče horší než originál?",
    a: "Pro investora z Česka spíš naopak. Akumulační verze dividendy rovnou reinvestuje, takže je nemusíte danit ani vykazovat. U amerických fondů navíc hrozí americká dědická daň u majetku nad 60 000 USD. Irské fondy se jí netýkají.",
  },
  {
    q: "Co za tahák chcete?",
    a: "Jen e-mail, na který vám pošleme tahák. Nic dalšího bez vašeho souhlasu neposíláme. Kdo chce, může si po stažení zapnout 4 krátké e-maily s tipy (broker, pravidelná investice, daně, DIP) a kdykoli je jedním klikem vypnout. Žádné telefonáty, žádný poradce.",
  },
  {
    q: "Je to investiční doporučení?",
    a: "Ne. Je to srovnání veřejných dat, zdroje najdete dole. Investice nesou riziko, hodnota může klesat a minulé výnosy nezaručují budoucí. Co a kdy koupíte, je na vás.",
  },
];
---

<Section id="otazky" track="faq">
  <Heading>Na co se lidé ptají</Heading>
  {items.map((item, i) => (
    <details data-faq={i + 1} class="group border-b border-line first-of-type:border-t">
      <summary
        class="relative cursor-pointer list-none py-4 pr-8 text-[17px] font-bold [&::-webkit-details-marker]:hidden after:absolute after:top-[13px] after:right-1 after:font-mono after:text-[20px] after:leading-none after:font-bold after:text-lime after:transition-transform after:duration-200 after:content-['+'] group-open:after:rotate-45"
      >{item.q}</summary>
      <p class="mb-4 text-[15.5px] text-fg-2">{item.a}</p>
    </details>
  ))}
</Section>

<script>
  import { track } from "@/lib/tracking";
  document.querySelectorAll<HTMLDetailsElement>("details[data-faq]").forEach((d) => {
    d.addEventListener("toggle", () => {
      if (d.open) track("faq_open", { q: Number(d.dataset.faq) }, { once: `faq${d.dataset.faq}` });
    });
  });
</script>
