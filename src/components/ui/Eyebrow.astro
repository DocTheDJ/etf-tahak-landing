---
// The small mono label above a heading. tone="coral" for the "blocked / warning" pages.
interface Props { tone?: "lime" | "coral" }
const { tone = "lime" } = Astro.props;
---

<p class:list={["mb-2.5 font-mono font-medium text-[12px] leading-[1.3] tracking-[0.08em] uppercase", tone === "lime" ? "text-lime" : "text-coral"]}>
  <slot />
</p>
