---
// Page shell: <head>, fonts, global styles, tracking and the consent bar.
// Fonts are self-hosted (no request to Google: works with content blockers, nothing to disclose under GDPR).
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import TickerTape from "@/components/TickerTape.astro";
import Footer from "@/components/Footer.astro";
import ConsentBar from "@/components/ConsentBar.vue";
import { config, hasThirdParty } from "@/config";

interface Props {
  title: string;
  description: string;
  /** Which ad this page belongs to. Sent with every tracking event and every lead. */
  variant: "fees" | "twins" | "page";
  noindex?: boolean;
  /** Scrolling ticker at the top: "pairs" (US ETF → twin) or "blocked" (what brokers refuse). */
  tape?: "pairs" | "blocked";
}
const { title, description, variant, noindex = false, tape = "pairs" } = Astro.props;
const askExperiment = variant === "twins" && config.askExperiment;
---

<!doctype html>
<html lang="cs" data-variant={variant} data-ask="early">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0e0f12" />
    <!-- The page is dark by design: tells browsers with a forced dark mode (Samsung Internet) to leave it alone. -->
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/img/og.png", Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />

    {askExperiment && (
      /* A/B test "ask" (README, hypothesis 2). Runs before first paint so the hero never flickers:
         URL override (?ask=early|late) > sticky assignment > random 50/50. CSS in HeroTwins reads data-ask. */
      <script is:inline>
        (function () {
          var arm = new URLSearchParams(location.search).get("ask");
          try { if (arm !== "early" && arm !== "late") arm = localStorage.getItem("exp_ask"); } catch (e) {}
          if (arm !== "early" && arm !== "late") arm = Math.random() < 0.5 ? "early" : "late";
          try { localStorage.setItem("exp_ask", arm); } catch (e) {}
          document.documentElement.dataset.ask = arm;
        })();
      </script>
    )}

  </head>
  <body>
    <TickerTape mode={tape} />
    <Header />
    <main class="mx-auto max-w-col px-4">
      <slot />
    </main>
    <Footer />
    {hasThirdParty && <ConsentBar client:idle />}

    <script>
      import { initTracking } from "@/lib/tracking";
      initTracking();
    </script>
  </body>
</html>
