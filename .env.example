# Every variable is declared (typed, with descriptions) in astro.config.mjs → env.schema.
# All optional: without them the site works and leads are written to the function logs.
# Local dev: copy to .env. Production: Vercel → Settings → Environment Variables, then redeploy.

# ---- public (inlined into the browser bundle at build time)
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
# PostHog EU Cloud project token (phc_…). Cookieless, no banner needed. In the PostHog project, turn ON
# Settings → Web analytics → "Cookieless server hash mode", otherwise events are dropped.
PUBLIC_POSTHOG_KEY=
PUBLIC_OPERATOR="Název s.r.o., IČO 12345678"
# A/B test "ask" on /dvojcata (README, hypothesis 2): on | off
PUBLIC_EXP_ASK=off

# ---- secret (read at runtime by src/pages/api/*)
# Persist leads + funnel: Upstash Redis free tier. Vercel's Upstash integration sets KV_REST_API_* instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Forward every lead as JSON (Make / Zapier / Ecomail / Google Apps Script → Sheet)
LEAD_WEBHOOK_URL=
# Email the PDF via Resend (domain must be verified in Resend)
RESEND_API_KEY=
MAIL_FROM="ETF tahák <tahak@example.cz>"
# Absolute base URL for links in emails (defaults to the request origin)
SITE_URL=
# Password for /api/stats?key=...
STATS_KEY=
