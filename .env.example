# All optional. Without them the page still works and leads are written to the function logs.

# Persist leads + funnel (Upstash Redis free tier, or Vercel Marketplace > Upstash, which sets KV_REST_API_* instead)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Forward every lead as JSON (Make / Zapier / Ecomail / Google Apps Script -> Sheet)
LEAD_WEBHOOK_URL=

# Email the PDF link via Resend (domain must be verified in Resend)
RESEND_API_KEY=
MAIL_FROM="ETF tahák <tahak@example.cz>"

# Absolute base URL used in emails (defaults to request host)
SITE_URL=

# Password for /api/stats?key=...
STATS_KEY=
